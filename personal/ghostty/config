# Herdr is the workspace manager for every new Ghostty terminal.
command = shell:exec "$HOME/.local/bin/herdr"
font-family = "Roboto Mono Light for Powerline"
font-family = "Menlo"
font-size = 12
theme = dark:Monokai Pro,light:GitHub Light Default
copy-on-select = true
# Preserve the previous terminal's multiline-input shortcut.
keybind = shift+enter=text:\x1b\r
keybind = cmd+enter=text:\x1b[13;5u
keybind = shift+cmd+enter=text:\x1b[13;10u
keybind = ctrl+cmd+f=toggle_fullscreen
keybind = cmd+h=text:\x0ep
keybind = cmd+l=text:\x0en
keybind = shift+cmd+[=unbind
keybind = shift+cmd+]=unbind
keybind = shift+cmd+left_bracket=unbind
keybind = shift+cmd+right_bracket=unbind
keybind = cmd+w=ignore
keybind = cmd+t=text:\x0ec
keybind = cmd+n=text:\x0eN
keybind = shift+cmd+n=text:\x0eP
keybind = cmd+r=text:\x0eT
keybind = shift+cmd+r=text:\x0eW
keybind = cmd+j=text:\x0eJ
keybind = cmd+k=text:\x0eK
keybind = shift+cmd+h=text:\x0eH
keybind = shift+cmd+l=text:\x0eL
keybind = shift+cmd+j=text:\x0ed
keybind = shift+cmd+k=text:\x0eu
keybind = cmd+b=text:\x0eb
keybind = cmd+semicolon=text:\x0e;
keybind = shift+cmd+p=text:\x0e\x09
keybind = shift+cmd+b=text:\x0eB
keybind = alt+cmd+h=text:\x0eh
keybind = alt+cmd+j=text:\x0ej
keybind = alt+cmd+k=text:\x0ek
keybind = alt+cmd+l=text:\x0el
keybind = shift+alt+cmd+h=text:\x0e\x1bh
keybind = shift+alt+cmd+j=text:\x0e\x1bj
keybind = shift+alt+cmd+k=text:\x0e\x1bk
keybind = shift+alt+cmd+l=text:\x0e\x1bl
keybind = alt+cmd+r=text:\x0e\x12
keybind = alt+cmd+w=text:\x0ex
keybind = alt+cmd+x=text:\x0ex
keybind = alt+cmd+n=activate_key_table_once:herdr_new_pane
keybind = herdr_new_pane/
keybind = herdr_new_pane/h=text:\x0e1
keybind = herdr_new_pane/alt+cmd+h=text:\x0e1
keybind = herdr_new_pane/j=text:\x0e2
keybind = herdr_new_pane/alt+cmd+j=text:\x0e2
keybind = herdr_new_pane/k=text:\x0e3
keybind = herdr_new_pane/alt+cmd+k=text:\x0e3
keybind = herdr_new_pane/l=text:\x0e4
keybind = herdr_new_pane/alt+cmd+l=text:\x0e4
keybind = herdr_new_pane/escape=ignore
keybind = herdr_new_pane/catch_all=ignore
keybind = shift+cmd+e=text:\x0eE
keybind = shift+cmd+m=text:\x0eM
keybind = cmd+slash=text:\x0e?
keybind = ctrl+alt+cmd+h=text:\x0e1
keybind = ctrl+alt+cmd+j=text:\x0e2
keybind = ctrl+alt+cmd+k=text:\x0e3
keybind = ctrl+alt+cmd+l=text:\x0e4
# Native Herdr utilities, also available through the Ctrl+N prefix.
keybind = alt+cmd+c=text:\x0e[
keybind = alt+cmd+e=text:\x0ee
keybind = alt+cmd+z=text:\x0ez
keybind = alt+cmd+s=text:\x0er
