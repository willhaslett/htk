{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTK task data",
  "description": "Semantic tasks, independent of presentation. IDs are unique across the entire task tree.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "tasks"],
  "properties": {
    "version": {"const": 1, "type": "integer"},
    "title": {"$ref": "#/$defs/nonempty"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "nonempty": {"type": "string", "pattern": "\\S"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state"],
      "properties": {
        "id": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
        "title": {"$ref": "#/$defs/nonempty"},
        "state": {"$ref": "#/$defs/nonempty"},
        "next": {"type": "string"},
        "notes": {"type": "string"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/task"}}
      }
    }
  }
}
